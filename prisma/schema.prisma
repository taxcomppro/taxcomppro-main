// ── NFC Physical Card Programmer ─────────────────────────────────────────────
// Maps a unique short cardId (written to the physical NFC tag URL) to a
// TaxCompPro Connect Card username. The username is mutable — the card URL
// never needs to be rewritten if a user changes their username.
//
// Physical NFC tag stores:   https://taxcomppro.com/c/ABC123
// /c/[cardId] → looks up ABC123 → finds username "naeem" → redirects to
// /connect/naeem (existing public TapCard profile page).
model NfcCard {
  id        String   @id @default(cuid())
  cardId    String   @unique              // e.g. "ABC123" — URL-safe short ID
  username  String                        // DigitalCard username (reassignable)
  url       String                        // https://taxcomppro.com/c/ABC123
  status    String   @default("ACTIVE")  // ACTIVE | REASSIGNED | DEACTIVATED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("nfc_cards")
}

// ── Pro Networks (Private Subscription Communities) ─────────────────────────
model ProNetwork {
  accentColor String @default("#65a832")
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  tagline             String?
  description         String   @db.Text
  category            String   @default("General")
  coverImage          String?
  logoImage           String?
  monthlyPrice        Float    @default(0)
  isPublished         Boolean  @default(true)
  memberCount         Int      @default(1)
  followerCount       Int      @default(0)

  // Creator / Owner
  ownerId             String
  owner               User     @relation("OwnedNetworks", fields: [ownerId], references: [id], onDelete: Cascade)

  // Rules, welcome & benefits
  rules               String?  @db.Text
  welcomeMessage      String?  @db.Text
  previewContent      String?  @db.Text
  memberBenefits      String[] @default([])

  // Custom Badge Creator fields
  badgeShape          String   @default("rounded") // rounded, shield, hexagon, circle, pill
  badgeInitials       String?
  badgeText           String   @default("MEMBER")
  badgeIcon           String   @default("Star")
  badgeBgColor        String   @default("#0a1628")
  badgeTextColor      String   @default("#f0c040")
  badgeBorderColor    String   @default("#d4a017")
  badgeCustomImage    String?

  // Direct Access Settings
  allowDirectMessage  Boolean  @default(true)
  allowDirectText     Boolean  @default(false)
  directTextPhone     String?
  allowQuestions      Boolean  @default(true)
  allowConsultations  Boolean  @default(true)
  consultationUrl     String?

  // Notifications default settings
  notifyAnnouncements Boolean  @default(true)
  notifyResources     Boolean  @default(true)
  notifyLiveEvents    Boolean  @default(true)
  notifyNewTraining   Boolean  @default(true)
  notifyNewPosts      Boolean  @default(true)
  notifyDiscussions   Boolean  @default(true)
  notifyEvents        Boolean  @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  members             ProNetworkMember[]
  followers           ProNetworkFollower[]
  announcements       ProNetworkAnnouncement[]
  discussions         ProNetworkDiscussion[]
  media               ProNetworkMedia[]
  resources           ProNetworkResource[]
  events              ProNetworkEvent[]
  chatMessages        ProNetworkChatMessage[]
  questions           ProNetworkQuestion[]
  products            ProNetworkProduct[]

  @@map("pro_networks")
}

model ProNetworkProduct {
  id         String             @id @default(cuid())
  networkId  String
  listingId  String
  order      Int                @default(0)
  isFeatured Boolean            @default(false)
  createdAt  DateTime           @default(now())

  network    ProNetwork         @relation(fields: [networkId], references: [id], onDelete: Cascade)
  listing    MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([networkId, listingId])
  @@map("pro_network_products")
}

model ProNetworkMember {
  id                   String     @id @default(cuid())
  networkId            String
  userId               String
  role                 String     @default("MEMBER") // OWNER, ADMIN, MODERATOR, MEMBER
  status               String     @default("ACTIVE") // ACTIVE, CANCELED, EXPIRED, PAST_DUE
  stripeSubscriptionId String?
  stripeCustomerId     String?
  joinedAt             DateTime   @default(now())
  expiresAt            DateTime?
  showInDirectory      Boolean    @default(true)
  notifications        Json?

  network              ProNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([networkId, userId])
  @@map("pro_network_members")
}

model ProNetworkFollower {
  id         String     @id @default(cuid())
