  @@map("academy_memberships")
}

model AcademyProduct {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productKey  String  @unique @map("product_key")
  title       String
  productType String  @map("product_type")
  active      Boolean @default(true)

  trainingVersions  AcademyTrainingVersion[]
  licenses          AcademyLicense[]
  courseDayProgress AcademyCourseDayProgress[]

  @@map("academy_products")
}

model AcademyLicense {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  productId          String    @map("product_id") @db.Uuid
  purchaserProfileId String    @map("purchaser_profile_id") @db.Uuid
  stripeSessionId    String?   @unique @map("stripe_session_id")
  seatsPurchased     Int       @map("seats_purchased")
  status             String    @default("ACTIVE")
  startsAt           DateTime  @default(now()) @map("starts_at")
  expiresAt          DateTime? @map("expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  organization AcademyOrganization @relation(fields: [organizationId],     references: [id])
  product      AcademyProduct      @relation(fields: [productId],           references: [id])
  purchaser    AcademyProfile      @relation("PurchaserProfile", fields: [purchaserProfileId], references: [id])
  invitations  AcademyInvitation[]
  assignments  AcademyAssignment[]

  @@map("academy_licenses")
}

model AcademyTrainingVersion {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  versionKey           String   @map("version_key")
  title                String
  passMark             Int      @default(80)  @map("pass_mark")
  maxAttempts          Int      @default(2)   @map("max_attempts")
  requiredWatchPercent Int      @default(90)  @map("required_watch_percent")
  acknowledgementText  String   @map("acknowledgement_text")
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")

  product     AcademyProduct          @relation(fields: [productId], references: [id])
  modules     AcademyLearningModule[]
  assignments AcademyAssignment[]
  questions   AcademyQuestion[]

  @@unique([productId, versionKey])
  @@map("academy_training_versions")
}

model AcademyInvitation {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  licenseId          String    @map("license_id") @db.Uuid
  invitedByProfileId String    @map("invited_by_profile_id") @db.Uuid
  fullName           String    @map("full_name")
  email              String
  token              String    @unique
  role               String    @default("PREPARER")
  locationId         String?   @map("location_id") @db.Uuid
  status             String    @default("SENT")
  expiresAt          DateTime  @map("expires_at")
  acceptedAt         DateTime? @map("accepted_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  organization AcademyOrganization @relation(fields: [organizationId],    references: [id], onDelete: Cascade)
  license      AcademyLicense      @relation(fields: [licenseId],          references: [id], onDelete: Cascade)
  invitedBy    AcademyProfile      @relation("InvitedBy", fields: [invitedByProfileId], references: [id])
  location     AcademyLocation?    @relation(fields: [locationId],         references: [id])
  assignments  AcademyAssignment[]

  @@map("academy_invitations")
}

model AcademyAssignment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  licenseId         String    @map("license_id") @db.Uuid
  trainingVersionId String    @map("training_version_id") @db.Uuid
  profileId         String?   @map("profile_id") @db.Uuid
  invitationId      String?   @map("invitation_id") @db.Uuid
  locationId        String?   @map("location_id") @db.Uuid
  status            String    @default("INVITATION_SENT")
  assignedAt        DateTime  @default(now()) @map("assigned_at")
  completedAt       DateTime? @map("completed_at")

  license         AcademyLicense         @relation(fields: [licenseId],         references: [id], onDelete: Cascade)
  trainingVersion AcademyTrainingVersion @relation(fields: [trainingVersionId], references: [id])
  profile         AcademyProfile?        @relation(fields: [profileId],         references: [id])
  invitation      AcademyInvitation?     @relation(fields: [invitationId],      references: [id])
  location        AcademyLocation?       @relation(fields: [locationId],        references: [id])
  videoProgress   AcademyVideoProgress?
  attempts        AcademyAssessmentAttempt[]
  acknowledgement AcademyAcknowledgement?
  certificate     AcademyCertificate?
  reminders       AcademyReminder[]

  @@unique([licenseId, profileId, trainingVersionId])
  @@map("academy_assignments")
}

model AcademyVideoProgress {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId    String    @unique @map("assignment_id") @db.Uuid
  watchedPercent  Int       @default(0) @map("watched_percent")
  furthestSeconds Int       @default(0) @map("furthest_seconds")
  positionSeconds Int       @default(0) @map("position_seconds")
  completedAt     DateTime? @map("completed_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  assignment AcademyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("academy_video_progress")
}

model AcademyQuestion {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trainingVersionId String  @map("training_version_id") @db.Uuid
  prompt            String
  options           Json
  correctOption     Int     @map("correct_option")
  explanation       String?
  active            Boolean @default(true)

  trainingVersion AcademyTrainingVersion @relation(fields: [trainingVersionId], references: [id], onDelete: Cascade)

  @@map("academy_questions")
}

model AcademyAssessmentAttempt {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId  String    @map("assignment_id") @db.Uuid
  attemptNumber Int       @map("attempt_number")
  questionIds   Json      @map("question_ids")
  answers       Json?
  score         Int?
  passed        Boolean?
  startedAt     DateTime  @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")

  assignment AcademyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, attemptNumber])
  @@map("academy_assessment_attempts")
