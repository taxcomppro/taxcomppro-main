model AcademyCourseDayProgress {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  dayNumber   Int       @map("day_number")
  reflection  String?
  status      String    @default("IN_PROGRESS")
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  profile AcademyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  product AcademyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([profileId, productId, dayNumber])
  @@map("academy_course_day_progress")
}

