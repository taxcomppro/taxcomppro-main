generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  PROFESSIONAL
  ADMIN
}

enum AppStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionTier {
  FREE
  VIP
  MARKETPLACE
  MARKETPLACE_PLUS
}

enum ListingCategory {
  SERVICE
  PRODUCT
  NETWORK
  TRAINING
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LessonContentType {
  VIDEO
  TEXT
  QUIZ
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum BlastStatus {
  PENDING_PAYMENT
  PENDING_APPROVAL
  APPROVED
  DELIVERED
  REJECTED
}

enum AdStatus {
  PENDING_PAYMENT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  REJECTED
  EXPIRED
}

enum AdPlacement {
  CENTER_COLUMN
  LEFT_COLUMN
}

enum FeaturedListingStatus {
  PENDING_PAYMENT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  EXPIRED
}

enum CardVisibility {
  PUBLIC
  MEMBERS_ONLY
  PRIVATE
}

enum TrainingStatus {
  INVITED
  REGISTERED
  TRAINING_STARTED
  VIDEO_COMPLETED
  ASSESSMENT_REQUIRED
  PASSED
  FAILED_RETAKE_REQUIRED
  TRAINING_COMPLETED
  ACCESS_REVOKED
}

model User {
  aiSpecialist AiSpecialist?
  profileSlug String? @unique
  professionalTitle String?
  id               String           @id @default(cuid())
  email            String           @unique
  emailVerified    Boolean          @default(false)
  name             String
  phone            String?
  role             Role             @default(MEMBER)
  tier             SubscriptionTier @default(FREE)
  image            String?
  coverImage       String?
  bio              String?
  firstFeedPostAt  DateTime?
  headline         String?
  location         String?
  yearsExperience  Int?
  mission          String?
  website          String?
  linkedIn         String?
  twitter          String?
  facebook         String?
  specialties      String[]
  certifications   String[]
  languages        String[]
  mediaPhotos      String[]
  stripeCustomerId   String?
  stripeAccountId    String?  // Stripe Connect Express account ID
  stripeOnboarded    Boolean  @default(false)
  voiceMemoUrl       String?  // Cloudinary URL of voice memo (max 4 min)
  createdAt          DateTime @default(now())
  updatedAt        DateTime         @updatedAt

  sessions            Session[]
  accounts            Account[]
  listings            MarketplaceListing[]
  createdCommunities  Community[]
  communityMembers    CommunityMember[]
  posts               Post[]
  comments            Comment[]
  postLikes           PostLike[]
  subscription        Subscription?
  notifications       Notification[]
  sentConnections     Connection[]         @relation("Requester")
  receivedConnections Connection[]         @relation("Receiver")
  followers           UserFollow[]         @relation("UserFollowers")
  following           UserFollow[]         @relation("UserFollowing")
  sentMessages        Message[]            @relation("SentMessages")
  receivedMessages    Message[]            @relation("ReceivedMessages")
  instructorCourses   Course[]             @relation("InstructorCourses")
  enrollments         Enrollment[]
  quizAttempts        QuizAttempt[]
  courseRatings       CourseRating[]
  affiliateProfile    AffiliateProfile?
  referredBy          AffiliateReferral[]  @relation("ReferredUser")
  hostedSpaces        Space[]
  spaceRsvps          SpaceRsvp[]
  spaceReports        SpaceReport[]
  spaceAttendances    SpaceAttendance[]
  proApplication      ProfessionalApplication?
  proServices         ProService[]
  reviewsReceived     ProReview[]  @relation("ReviewedPro")
  reviewsGiven        ProReview[]  @relation("Reviewer")
  toolkitPurchases    ToolkitPurchase[]
  messageBlasts       MessageBlast[]
  proAds              ProAd[]
  featuredListings    FeaturedListingRequest[]
  forums              Forum[]
  forumPosts          ForumPost[]
  forumComments       ForumComment[]
  forumVotes          ForumVote[]
  marketplacePurchases MarketplacePurchase[]
  sellerCoupons        MarketplaceCoupon[]     @relation("SellerCoupons")
  sellerReferrals      MarketplaceReferral[]   @relation("SellerReferrals")
  digitalCard         DigitalCard?
  trainingLicenses     TrainingLicense[]
  eroInvitationsSent   StaffInvitation[] @relation("EroInvitations")
  preparerInvitations  StaffInvitation[] @relation("PreparerInvitations")
  ownedNetworks        ProNetwork[]      @relation("OwnedNetworks")
  networkMemberships   ProNetworkMember[]
  networkFollows       ProNetworkFollower[]
  networkAnnouncements ProNetworkAnnouncement[]
  networkDiscussions   ProNetworkDiscussion[]
  networkReplies       ProNetworkDiscussionReply[]
  networkMedia         ProNetworkMedia[]
  networkResources     ProNetworkResource[]
  networkEvents        ProNetworkEvent[]
  networkEventRsvps    ProNetworkEventRsvp[]
  networkChatMessages  ProNetworkChatMessage[]
  networkQuestions     ProNetworkQuestion[]
  newsletterCampaigns  NewsletterCampaign[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model MarketplaceListing {
  id                 String          @id @default(cuid())
  slug               String?         @unique
  title              String
  description        String
  category           ListingCategory
  price              Float?
  images             String[]
  tags               String[]
  status             ListingStatus   @default(PENDING)
  isFeatured         Boolean         @default(false)
  isNetworkExclusive Boolean         @default(false)
  exclusiveNetworkId String?
  userId             String
  viewCount          Int             @default(0)
  metadata           Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  featuredRequests FeaturedListingRequest[]
  purchases        MarketplacePurchase[]
  coupons          MarketplaceCoupon[]
  referrals        MarketplaceReferral[]
  networkProducts  ProNetworkProduct[]
  taggedInSpaces   Space[]             @relation("SpaceTaggedListing")

  @@map("marketplace_listings")
}

model MarketplaceCoupon {
  id            String             @id @default(cuid())
  code          String
  discountType  String             @default("PERCENT") // "PERCENT" | "FIXED"
  discountValue Float              // e.g. 20 (for 20%) or 15 (for $15)
  maxUses       Int?
  usedCount     Int                @default(0)
  expiresAt     DateTime?
  isActive      Boolean            @default(true)
  sellerId      String
  listingId     String?            // null = all listings of seller; "MEMBERSHIP", "COURSES", "TOOLKITS", etc.
  durationMonths Int?              @default(1) // Duration in months for membership/subscription discounts (e.g. 1, 2, 3, 6, 12)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  seller        User               @relation("SellerCoupons", fields: [sellerId], references: [id], onDelete: Cascade)
  listing       MarketplaceListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([sellerId, code])
  @@map("marketplace_coupons")
}

model MarketplaceReferral {
  id             String             @id @default(cuid())
  code           String             @unique
  sellerId       String
  listingId      String?
  clicks         Int                @default(0)
  conversions    Int                @default(0)
  earningsUsd    Float              @default(0)
  commissionRate Float              @default(10) // 10%
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  seller         User               @relation("SellerReferrals", fields: [sellerId], references: [id], onDelete: Cascade)
  listing        MarketplaceListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("marketplace_referrals")
}

model MarketplacePurchase {
  id              String             @id @default(cuid())
  userId          String
  listingId       String
  price           Float              @default(0)
  stripeSessionId String?            @unique
  source          String             @default("MARKETPLACE") // "MARKETPLACE", "PRO_NETWORK", "PROFILE", "EVENT"
  networkId       String?
  createdAt       DateTime           @default(now())

  user    User               @relation(fields: [userId],    references: [id], onDelete: Cascade)
  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@map("marketplace_purchases")
}

model FeaturedListingRequest {
  id               String                 @id @default(cuid())
  userId           String
  listingId        String
  durationMonths   Int
  priceUsd         Float
  status           FeaturedListingStatus  @default(PENDING_PAYMENT)
  stripeSessionId  String?
  rejectionReason  String?
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("featured_listing_requests")
}


model Community {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  coverImage  String?
  icon        String?
  isPublic    Boolean  @default(true)
  creatorId   String
  memberCount Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator User              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  members CommunityMember[]
  posts   Post[]

  @@map("communities")
}

model CommunityMember {
  id          String   @id @default(cuid())
  userId      String
  communityId String
  role        String   @default("MEMBER")
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@map("community_members")
}

model Post {
  id          String    @id @default(cuid())
  content     String
  authorId    String
  communityId String?
  images      String[]
  videoUrl    String?
  likeCount   Int       @default(0)
  commentCount Int      @default(0)
  scheduledAt DateTime?
  isRepost    Boolean   @default(false)
  originalPostId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  comments  Comment[]
  likes     PostLike[]
  originalPost Post? @relation("PostReposts", fields: [originalPostId], references: [id], onDelete: SetNull)
  reposts Post[] @relation("PostReposts")

  @@unique([authorId, originalPostId])
  @@index([originalPostId])
  @@map("posts")
}

model UserFollow {
  followerId String
  followingId String
  createdAt DateTime @default(now())
  follower User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("user_follows")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  postId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model PostLike {
  reaction  String   @default("LIKE")
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("post_likes")
}

model Subscription {
  id                   String           @id @default(cuid())
  userId               String           @unique
  plan                 SubscriptionTier
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String           @default("active")
  currentPeriodEnd     DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@map("connections")
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  content     String   @default("")
  fileUrl     String?
  fileName    String?
  fileType    String?
  isRead      Boolean  @default(false)
  isSponsored Boolean  @default(false)
  blastId     String?
  createdAt   DateTime @default(now())

  sender   User          @relation("SentMessages",   fields: [senderId],   references: [id], onDelete: Cascade)
  receiver User          @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  blast    MessageBlast? @relation(fields: [blastId], references: [id], onDelete: SetNull)

  @@map("messages")
}

model MessageBlast {
  id              String      @id @default(cuid())
  senderId        String
  subject         String
  content         String
  filterRoles     String[]
  filterCities    String[]
  filterStates    String[]
  recipientCount  Int
  priceUsd        Float
  stripeSessionId String?
  status          BlastStatus @default(PENDING_PAYMENT)
  blastMonth      String      // e.g. "2026-04"
  rejectionReason String?
  deliveredAt     DateTime?
  createdAt       DateTime    @default(now())

  sender   User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("message_blasts")
}

model Course {
  id            String       @id @default(cuid())
  slug          String       @unique
  title         String
  description   String
  thumbnail     String?
  level         CourseLevel  @default(BEGINNER)
  status        CourseStatus @default(DRAFT)
  price         Float        @default(0)
  isFree        Boolean      @default(true)
  isSequential  Boolean      @default(true)
  category      String
  tags          String[]
  learningOutcomes String[]
  requirements     String[]
  totalDuration Int          @default(0)
  downloadUrl   String?
  downloadName  String?
  instructorId  String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  instructor    User          @relation("InstructorCourses", fields: [instructorId], references: [id])
  sections    CourseSection[]
  enrollments Enrollment[]
  ratings       CourseRating[]

  @@map("courses")
}

model CourseSection {
  id        String   @id @default(cuid())
  title     String
  order     Int
  courseId  String
  createdAt DateTime @default(now())

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@map("course_sections")
}

model Lesson {
  id          String            @id @default(cuid())
  title       String
  description String?
  contentType LessonContentType @default(VIDEO)
  videoUrl    String?
  textContent String?
  downloadUrl String?
  downloadName String?
  duration    Int               @default(0)
  order       Int
  isFree      Boolean           @default(false)
  sectionId   String
  createdAt   DateTime          @default(now())

  section  CourseSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress LessonProgress[]
  quiz     Quiz?

  @@map("lessons")
}

model Quiz {
  id        String   @id @default(cuid())
  lessonId  String   @unique
  title     String
  passMark  Int      @default(70)
  createdAt DateTime @default(now())

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  question      String
  options       String[]
  correctAnswer Int
  explanation   String?
  order         Int

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  score       Int
  passed      Boolean
  answers     Int[]
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@unique([userId, courseId])
  @@map("enrollments")
}

model LessonProgress {
  id           String   @id @default(cuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@map("lesson_progress")
}

model CourseRating {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int
  review    String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("course_ratings")
}

model AffiliateProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  code                 String   @unique
  isActive             Boolean  @default(true)
  totalEarned          Float    @default(0)
  totalPaid            Float    @default(0)
  pendingBalance       Float    @default(0)
  customCommissionRate Float?
  customVip            Float?
  customMarketplace    Float?
  customPlus           Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals AffiliateReferral[]
  payouts   AffiliatePayout[]

  @@map("affiliate_profiles")
}

model AffiliateReferral {
  id             String           @id @default(cuid())
  affiliateId    String
  referredUserId String
  tier           SubscriptionTier
  commission     Float
  createdAt      DateTime         @default(now())

  affiliate    AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUser User             @relation("ReferredUser", fields: [referredUserId], references: [id])

  @@map("affiliate_referrals")
}

model AffiliatePayout {
  id          String       @id @default(cuid())
  affiliateId String
  amount      Float
  method      String       @default("paypal")
  details     String
  status      PayoutStatus @default(PENDING)
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  affiliate AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@map("affiliate_payouts")
}

model AffiliateSettings {
  id                    String   @id @default(cuid())
  commissionVip         Float    @default(10)
  commissionMarketplace Float    @default(15)
  commissionPlus        Float    @default(20)
  minPayoutAmount       Float    @default(50)
  cookieDays            Int      @default(30)
  programEnabled        Boolean  @default(true)
  updatedAt             DateTime @updatedAt

  @@map("affiliate_settings")
}

model AtlasSettings {
  id              String   @id @default(cuid())
  widgetEnabled   Boolean  @default(true)
  defaultProvider String   @default("openai")
  allowedTiers    String[] @default(["FREE","VIP","MARKETPLACE","MARKETPLACE_PLUS"])
  maxTokens       Int      @default(1024)
  systemPromptExtra String @default("")
  updatedAt       DateTime @updatedAt

  @@map("atlas_settings")
}

model Space {
  id                    String    @id @default(cuid())
  name                  String
  description           String?
  hostId                String
  roomName              String    @unique
  category              String    @default("Open Discussion")
  mediaType             String    @default("AUDIO_VIDEO") // "AUDIO", "VIDEO", "AUDIO_VIDEO"
  isLive                Boolean   @default(true)
  scheduledAt           DateTime?           // null = started immediately; future = scheduled
  shareToken            String?   @unique   // short token for shareable invite link
  totalAttendees        Int       @default(0)
  peakAttendees         Int       @default(0)
  replayUrl             String?
  replayDurationMinutes Int?
  isReplay              Boolean   @default(false)
  coHostIds             String[]  @default([])
  visibility            String    @default("PUBLIC")
  taggedListingId       String?
  createdAt             DateTime  @default(now())
  endedAt               DateTime?

  host          User                @relation(fields: [hostId], references: [id], onDelete: Cascade)
  taggedListing MarketplaceListing? @relation("SpaceTaggedListing", fields: [taggedListingId], references: [id], onDelete: SetNull)
  rsvps         SpaceRsvp[]
  reports       SpaceReport[]
  attendances   SpaceAttendance[]

  @@map("spaces")
}

model SpaceRsvp {
  id        String   @id @default(cuid())
  spaceId   String
  userId    String?
  name      String
  email     String?
  createdAt DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@map("space_rsvps")
}

model SpaceReport {
  id             String   @id @default(cuid())
  spaceId        String
  reporterId     String
  reportedUserId String?
  reason         String
  details        String?
  status         String   @default("PENDING") // PENDING, REVIEWED, DISMISSED, ACTION_TAKEN
  createdAt      DateTime @default(now())

  space    Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  reporter User  @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("space_reports")
}

model SpaceAttendance {
  id        String    @id @default(cuid())
  spaceId   String
  userId    String?
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@map("space_attendances")
}

model SpaceCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("space_categories")
}

model ProfessionalApplication {
