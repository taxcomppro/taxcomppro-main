model AcademyAcknowledgement {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId  String   @unique @map("assignment_id") @db.Uuid
  statementHash String   @map("statement_hash")
  signerName    String   @map("signer_name")
  signerIp      String?  @map("signer_ip")
  userAgent     String?  @map("user_agent")
  signedAt      DateTime @default(now()) @map("signed_at")

  assignment AcademyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("academy_acknowledgements")
}

model AcademyCertificate {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId      String   @unique @map("assignment_id") @db.Uuid
  certificateNumber String   @unique @map("certificate_number")
  issuedAt          DateTime @default(now()) @map("issued_at")
  status            String   @default("ACTIVE")

  assignment AcademyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("academy_certificates")
}

model AcademyAuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorProfileId String?  @map("actor_profile_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization AcademyOrganization? @relation(fields: [organizationId], references: [id])
