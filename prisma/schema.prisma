  @@map("pro_ads")
}

model Forum {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  image       String?
  isAdminOnly Boolean     @default(false)
  isPinned    Boolean     @default(false)
  badge       String?
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  posts       ForumPost[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("forums")
}

model ForumPost {
  id        String         @id @default(cuid())
  title     String
  body      String         @db.Text
  forumId   String
  forum     Forum          @relation(fields: [forumId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id])
  votes     Int            @default(0)
  isPinned  Boolean        @default(false)
  comments  ForumComment[]
  userVotes ForumVote[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("forum_posts")
}

model ForumComment {
  id        String         @id @default(cuid())
  body      String         @db.Text
  postId    String
  post      ForumPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id])
  parentId  String?
  parent    ForumComment?  @relation("Replies", fields: [parentId], references: [id])
  replies   ForumComment[] @relation("Replies")
  votes     Int            @default(0)
  createdAt DateTime       @default(now())

  @@map("forum_comments")
}

model ForumVote {
  id     String    @id @default(cuid())
  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation(fields: [userId], references: [id])
  value  Int

  @@unique([postId, userId])
  @@map("forum_votes")
}

model ToolkitAsset {
  id         String   @id @default(cuid())
  toolkitId  String   @unique   // matches id in lib/toolkits.ts
  fileUrl    String             // Cloudinary secure URL
  fileName   String             // original file name for display
  fileSize   Int?               // bytes
  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("toolkit_assets")
}

model SupportTicket {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  email       String
  subject     String
  description String
  status      String   @default("OPEN")
  feedback    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("support_tickets")
}

// ── NFC Business Card / Tap Card / Connect Card ─────────────────────────
// One DigitalCard per User (internal FK = userId). `username` is the mutable,
// public-facing slug used in /connect/[username] and /pro/[username] — never
// used for DB relationships.
model DigitalCard {
  id        String  @id @default(cuid())
  userId    String  @unique
  username  String  @unique

  isPurchased Boolean   @default(false)
  stripeSessionId String?
  isActivated Boolean   @default(false)
  activatedAt DateTime?

  // Card-specific business info (distinct from the member's main profile fields)
  professionalTitle   String?
  businessName        String?
  businessDescription String?
  phone               String?
  bookingUrl          String?
  businessAddress     String?
  logoUrl             String?

  // Design
  theme       String @default("classic")
  accentColor String @default("#0a1628")

  // Privacy controls (per-field visibility)
  phoneVisibility     CardVisibility @default(PUBLIC)
  emailVisibility     CardVisibility @default(PUBLIC)
  addressVisibility   CardVisibility @default(PRIVATE)
  bookingVisibility   CardVisibility @default(PUBLIC)
  websiteVisibility   CardVisibility @default(PUBLIC)
  socialVisibility    CardVisibility @default(PUBLIC)
  servicesVisibility  CardVisibility @default(PUBLIC)

  // Analytics counters
  pageViews         Int @default(0)
  nfcTaps           Int @default(0)
  qrScans           Int @default(0)
  contactSaves      Int @default(0)
  shareClicks       Int @default(0)
  fullProfileClicks Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  links CardLink[]

  @@map("digital_cards")
}

model CardLink {
  id     String @id @default(cuid())
  cardId String

  label String
  url   String
  icon  String?
  color String?

  order      Int     @default(0)
  isActive   Boolean @default(true)
  clickCount Int     @default(0)

  scheduledStart DateTime?
  scheduledEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card DigitalCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("card_links")
}

// ── ERO Training Center (staff due-diligence training) ──────────────────
// One TrainingVersion per filing-season edition of a toolkit's training
// (e.g. "2027 Filing Season Due-Diligence Staff Training" for toolkitId
// "irs-fine-defense"). Historical versions are preserved — never overwritten
// — so completed-training records always show which edition a preparer took.
model TrainingVersion {
  id        String  @id @default(cuid())
  toolkitId String
  versionLabel String

  isActive Boolean @default(true)

  videoProvider        String @default("youtube")
  videoId              String?
  videoUrl             String?
  videoDurationSeconds Int    @default(0)

  passingScore    Int @default(80)
  questionsToShow Int @default(25)
  maxAttempts     Int @default(2)

  acknowledgmentText String @default("") @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions   TrainingQuestion[]
  invitations StaffInvitation[]

  @@map("training_versions")
}

model TrainingQuestion {
  id           String  @id @default(cuid())
  versionId    String
  question     String  @db.Text
  options      String[]
  correctIndex Int
  explanation  String? @db.Text
  order        Int     @default(0)

  createdAt DateTime @default(now())

  version TrainingVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@map("training_questions")
}

// The ERO's seat license for a toolkit's staff training (auto-created with
// 5 seats when the toolkit is purchased; additional seats can be bought).
model TrainingLicense {
  id         String  @id @default(cuid())
  eroId      String
  toolkitId  String
  officeName String?
  totalSeats Int     @default(5)

  purchasedAt DateTime @default(now())
  expiresAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ero           User                   @relation(fields: [eroId], references: [id], onDelete: Cascade)
  invitations   StaffInvitation[]
  seatPurchases TrainingSeatPurchase[]

  @@unique([eroId, toolkitId])
  @@map("training_licenses")
}

model TrainingSeatPurchase {
  id              String   @id @default(cuid())
  licenseId       String
  seats           Int
  priceUsd        Float
  stripeSessionId String   @unique
  createdAt       DateTime @default(now())

  license TrainingLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@map("training_seat_purchases")
}

// One seat assignment = one invited preparer. Each preparer gets their own
// individual account (userId links once they accept + register) — never a
// shared office login.
model StaffInvitation {
  id        String @id @default(cuid())
  licenseId String
  eroId     String
  versionId String
  userId    String?

  name        String
  email       String
  inviteToken String         @unique
  status      TrainingStatus @default(INVITED)

  videoFurthestSeconds Int       @default(0)
  videoCompletedAt     DateTime?
  trainingStartedAt    DateTime?
  registeredAt         DateTime?
  revokedAt            DateTime?

  invitedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  license        TrainingLicense         @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  ero            User                    @relation("EroInvitations", fields: [eroId], references: [id], onDelete: Cascade)
  version        TrainingVersion         @relation(fields: [versionId], references: [id])
  user           User?                   @relation("PreparerInvitations", fields: [userId], references: [id], onDelete: SetNull)
  attempts       AssessmentAttempt[]
  acknowledgment TrainingAcknowledgment?
  certificate    TrainingCertificate?

  @@unique([licenseId, email])
  @@map("staff_invitations")
}

model AssessmentAttempt {
  id            String    @id @default(cuid())
  invitationId  String
  attemptNumber Int
  questionIds   String[]
  answers       Int[]
  score         Int
  passed        Boolean
  startedAt     DateTime  @default(now())
  submittedAt   DateTime?

  invitation StaffInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("assessment_attempts")
}

model TrainingAcknowledgment {
  id            String   @id @default(cuid())
  invitationId  String   @unique
  fullName      String
  email         String
  officeName    String?
  versionLabel  String
  statements    String[]
  signatureName String
  ipAddress     String?
  userAgent     String?
  signedAt      DateTime @default(now())

  invitation StaffInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("training_acknowledgments")
}

model TrainingCertificate {
  id                String   @id @default(cuid())
  invitationId      String   @unique
  certificateNumber String   @unique
  pdfUrl            String?
  score             Int
  versionLabel      String
  issuedAt          DateTime @default(now())

  invitation StaffInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("training_certificates")
}

// ── Atlas Academy Models ─────────────────────────────────────────────────────

model AcademyProfile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId  String   @unique @map("clerk_user_id")
  tcpUserId    String?  @unique @map("tcp_user_id")
  email        String
  fullName     String   @map("full_name")
  role         String   @default("LEARNER")
  createdAt    DateTime @default(now()) @map("created_at")
