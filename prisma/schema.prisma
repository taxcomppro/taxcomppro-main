  title           String
  description     String?
  imageUrl        String
  linkUrl         String
  placement       AdPlacement
  durationMonths  Int
  priceUsd        Float
  stripeSessionId String?
  status          AdStatus     @default(PENDING_PAYMENT)
  rejectionReason String?
  startsAt        DateTime?
  endsAt          DateTime?
