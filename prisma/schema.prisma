model EmailTemplate {
  id          String     @id @default(cuid())
  key         String     @unique
  name        String
  category    String     @default("AUTH") // AUTH, SUPPORT, BILLING, SYSTEM
  description String     @db.Text
  subject     String
  preheader   String?
  heading     String
  bodyHtml    String     @db.Text
  buttonLabel String?
  buttonUrl   String?
  footerNote  String?
  isActive    Boolean    @default(true)
  variables   String[]   @default([])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  logs        EmailLog[]

  @@map("email_templates")
}

model EmailLog {
  id           String         @id @default(cuid())
  recipient    String
  subject      String
  templateKey  String?
  status       String         @default("SENT") // SENT, FAILED
  errorMessage String?        @db.Text
  html         String         @db.Text
  metadata     Json?
  createdAt    DateTime       @default(now())

  template     EmailTemplate? @relation(fields: [templateKey], references: [key], onDelete: SetNull)

  @@index([recipient])
  @@index([templateKey])
  @@index([status])
  @@index([createdAt])
  @@map("email_logs")
}


model AiSpecialist {
  id String @id
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String
  about String @db.Text
  expertise String[]
  starters String[]
  signature String
  courseNames String[]
  personality String @db.Text
  boundaries String @db.Text
  provider String @default("auto")
  model String @default("auto")
  temperature Float @default(0.7)
  postTone String @default("authoritative")
  postLength String @default("standard")
  postDays String[] @default([])
  postTime String @default("14:00")
  timezone String @default("UTC")
  maxDailyReplies Int @default(20)
  customPrompt String? @db.Text
  enabled Boolean @default(true)
  autoPublish Boolean @default(false)
  autoReply Boolean @default(false)
  weeklyPosts Int @default(2)
  destination String @default("FEED")
  destinationId String?
  knowledge Json @default("[]")
  activities AiActivity[]
  updatedAt DateTime @updatedAt
  @@map("ai_specialists")
}
model AiActivity {
  id String @id @default(cuid())
  specialistId String
  specialist AiSpecialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  key String @unique
  kind String @default("POST")
  status String @default("GENERATING")
  destination String
  destinationId String?
  parentId String?
  content String @default("") @db.Text
  provider String?
  error String?
  publishedUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([specialistId, createdAt])
  @@map("ai_activities")
}

