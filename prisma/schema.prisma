model AcademyReminder {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId String    @map("assignment_id") @db.Uuid
  reminderType String    @default("TRAINING_INCOMPLETE") @map("reminder_type")
  scheduledFor DateTime  @map("scheduled_for")
  status       String    @default("SCHEDULED")
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  assignment AcademyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("academy_reminders")
}

model AcademyLearningModule {
